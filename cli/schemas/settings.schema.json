{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lividlabs/codefall-cli/main/schemas/settings.schema.json",
  "title": "Codefall settings",
  "description": "Per-repository configuration read from .codefall/settings.json.",
  "type": "object",
  "required": ["version", "tracker", "harnesses"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "tracker": { "type": "string", "enum": ["beads", "github"] },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["antigravity", "claude-code", "codex", "muse", "opencode"]
      }
    },
    "beads": { "type": "object", "properties": {}, "additionalProperties": true },
    "github": {
      "type": "object",
      "required": ["issuesRepo"],
      "properties": {
        "issuesRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "issuesProject": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["postToPullRequest"],
      "properties": {
        "postToPullRequest": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "local": {
      "description": "The project's local-environment commands, each a shell command run from the project root (ADR-005).",
      "type": "object",
      "required": ["start", "update"],
      "properties": {
        "start": { "type": "string", "description": "Brings up what the project needs running locally. Idempotent." },
        "update": { "type": "string", "description": "Makes the local environment match the checkout. Idempotent; may assume start has run." }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    { "properties": { "tracker": { "const": "beads" }, "github": false }, "required": ["tracker", "beads"] },
    { "properties": { "tracker": { "const": "github" }, "beads": false }, "required": ["tracker", "github"] }
  ],
  "additionalProperties": true
}
