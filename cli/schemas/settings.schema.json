{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lividlabs/codefall-cli/main/schemas/settings.schema.json",
  "title": "Codefall settings",
  "description": "Per-repository configuration read from .codefall/settings.json.",
  "type": "object",
  "required": ["version", "tracker"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "tracker": { "type": "string", "enum": ["beads", "github"] },
    "beads": { "type": "object", "properties": {}, "additionalProperties": true },
    "github": {
      "type": "object",
      "required": ["issuesRepo"],
      "properties": {
        "issuesRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "issuesProject": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["postToPullRequest"],
      "properties": {
        "postToPullRequest": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    { "properties": { "tracker": { "const": "beads" }, "github": false }, "required": ["tracker", "beads"] },
    { "properties": { "tracker": { "const": "github" }, "beads": false }, "required": ["tracker", "github"] }
  ],
  "additionalProperties": true
}
